# OpenHive Configuration
# Copy this file to .env.local and fill in your values
# Or use the setup wizard at http://localhost:3000/setup

# ---- Supabase (required) ----
# Get these from: Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ---- LiveKit (optional — for video/audio calls) ----
# Get these from: cloud.livekit.io or your self-hosted LiveKit server
# Set these server-side values to use one LiveKit project without saving its
# secret in workspace_settings. Admins must still enable calls per workspace.
# Set the public flag to true only when all three values are present.
# NEXT_PUBLIC_LIVEKIT_SERVER_CONFIGURED=true
# LIVEKIT_ALLOWED_WORKSPACE_ID=your-workspace-uuid
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=your-api-key
# LIVEKIT_API_SECRET=your-api-secret
